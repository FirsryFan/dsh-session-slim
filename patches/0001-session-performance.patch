@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest'
+import {
+  isSourceSeqRange,
+  sourceSeqCompress,
+  sourceSeqExpand,
+  sourceSeqIncludes,
+  sourceSeqMin,
+} from '@deepseek-ai/dsh-session'
+
+describe('sourceSeq helpers', () => {
+  it('compresses consecutive arrays of at least three entries into a range', () => {
+    const compressed = sourceSeqCompress([16, 17, 18, 19, 20])
+    expect(isSourceSeqRange(compressed)).toBe(true)
+    if (!isSourceSeqRange(compressed)) throw new Error('unreachable')
+    expect(compressed).toEqual({ start: 16, end: 20 })
+    expect(sourceSeqMin(compressed)).toBe(16)
+    expect(sourceSeqExpand(compressed)).toEqual([16, 17, 18, 19, 20])
+    expect(sourceSeqIncludes(compressed, 18)).toBe(true)
+    expect(sourceSeqIncludes(compressed, 15)).toBe(false)
+    expect(sourceSeqIncludes(compressed, 21)).toBe(false)
+  })
+
+  it('keeps small arrays and non-consecutive arrays as arrays', () => {
+    expect(sourceSeqCompress([1, 2])).toEqual([1, 2])
+    expect(sourceSeqCompress([1, 3, 5])).toEqual([1, 3, 5])
+    expect(isSourceSeqRange(sourceSeqCompress([]))).toBe(false)
+  })
+
+  it('expands an empty array to an empty array and min returns -1', () => {
+    expect(sourceSeqExpand([])).toEqual([])
+    expect(sourceSeqMin([])).toBe(-1)
+  })
+
+  it('round-trips legacy arrays through expand unchanged', () => {
+    const sources = [4, 9, 12]
+    expect(sourceSeqExpand(sources)).toEqual(sources)
+  })
+})
