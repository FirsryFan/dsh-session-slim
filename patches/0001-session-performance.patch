--- /dev/null
+++ b/packages/core/session/src/source-seq.ts
@@ -0,0 +1,69 @@
+/**
+ * Compact representation for `sourceEventSeqs`.
+ *
+ * Most large provenance sets are the consecutive seqs of an assistant stream
+ * (e.g. chunk seq 16..48718). Storing those as a plain number array is the
+ * dominant session-log bloat for long reasoning/tool outputs. This module
+ * provides a range form and helpers that accept both the legacy array form and
+ * the compact range form, so old logs and small non-consecutive sets keep
+ * working unchanged.
+ *
+ * @module @deepseek-ai/dsh-session/source-seq
+ */
+
+/**
+ * A dense inclusive range of earlier event seqs.
+ * `start` and `end` are both non-negative safe integers with `start <= end`.
+ */
+export interface SourceSeqRange {
+  readonly start: number
+  readonly end: number
+}
+
+/** Accepted wire/storage shape for `sourceEventSeqs`. */
+export type SourceEventSeqs = number[] | SourceSeqRange
+
+export function isSourceSeqRange(value: unknown): value is SourceSeqRange {
+  return typeof value === 'object'
+    && value !== null
+    && !Array.isArray(value)
+    && typeof (value as SourceSeqRange).start === 'number'
+    && typeof (value as SourceSeqRange).end === 'number'
+}
+
+/** Smallest cited source seq. */
+export function sourceSeqMin(value: SourceEventSeqs): number {
+  if (isSourceSeqRange(value)) return value.start
+  return value.length === 0 ? -1 : value[0] as number
+}
+
+/** Whether a specific earlier seq is cited. */
+export function sourceSeqIncludes(value: SourceEventSeqs | undefined, seq: number): boolean {
+  if (value === undefined) return false
+  if (isSourceSeqRange(value)) return seq >= value.start && seq <= value.end
+  return value.includes(seq)
+}
+
+/** Expand a compact range back to a plain array (mainly for legacy consumers). */
+export function sourceSeqExpand(value: SourceEventSeqs): number[] {
+  if (!isSourceSeqRange(value)) return [...value]
+  const out: number[] = []
+  for (let seq = value.start; seq <= value.end; seq++) out.push(seq)
+  return out
+}
+
+/**
+ * Compress a plain array into a range when it is non-empty, strictly
+ * consecutive, and large enough to be worth it; otherwise return the array
+ * unchanged. Small or sparse sets stay arrays so consumers that rely on the
+ * array shape keep working.
+ */
+export function sourceSeqCompress(seqs: readonly number[]): SourceEventSeqs {
+  if (seqs.length < 3) return [...seqs]
+  const start = seqs[0] as number
+  const end = seqs[seqs.length - 1] as number
+  for (let index = 1; index < seqs.length; index++) {
+    if ((seqs[index] as number) !== start + index) return [...seqs]
+  }
+  return { start, end }
+}
